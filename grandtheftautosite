<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>GTA VI | Vice City</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #08040d;
            color: white;
        }

        /* =========================
           MENU
        ========================= */

        header {
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;

            padding: 18px 7%;

            display: flex;
            justify-content: space-between;
            align-items: center;

            background: rgba(0,0,0,0.75);
            backdrop-filter: blur(10px);
        }

        .logo {
            font-size: 30px;
            font-weight: bold;
            color: white;
        }

        .logo span {
            color: #ff299f;
        }

        nav a {
            color: white;
            text-decoration: none;

            margin-left: 25px;

            font-weight: bold;
            font-size: 14px;

            transition: 0.3s;
        }

        nav a:hover {
            color: #ff299f;
        }


        /* =========================
           HERO
        ========================= */

        .hero {

            height: 100vh;

            display: flex;
            align-items: center;

            padding: 100px 8%;

            background:
                linear-gradient(
                    90deg,
                    rgba(5,0,15,0.95),
                    rgba(5,0,15,0.45)
                ),
                url("https://images.unsplash.com/photo-1507525428034-b723cf961d3e")
                center/cover;

        }

        .hero-content {
            max-width: 700px;
        }

        .small-title {
            color: #ff299f;

            font-size: 14px;
            font-weight: bold;

            letter-spacing: 4px;

            margin-bottom: 15px;
        }

        h1 {

            font-size: clamp(80px, 15vw, 180px);

            line-height: 0.75;

            margin-bottom: 30px;

            text-shadow:
                5px 5px #ff299f,
                10px 10px #6b1cff;

        }

        .hero h2 {

            font-size: 45px;

            margin-bottom: 20px;

        }

        .hero h2 span {
            color: #ff299f;
        }

        .hero p {

            color: #ddd;

            line-height: 1.7;

            margin-bottom: 30px;

        }


        /* =========================
           BOTÕES
        ========================= */

        .btn {

            display: inline-block;

            padding: 15px 25px;

            margin-right: 10px;

            border: none;

            text-decoration: none;

            font-weight: bold;

            cursor: pointer;

            transition: 0.3s;

        }

        .btn-primary {

            background: #ff299f;

            color: white;

        }

        .btn-secondary {

            background: transparent;

            color: white;

            border: 1px solid white;

        }

        .btn:hover {

            transform: translateY(-4px);

            box-shadow:
                0 10px 30px rgba(255,41,159,0.4);

        }


        /* =========================
           SEÇÕES
        ========================= */

        section {

            padding: 100px 8%;

        }

        .section-title {

            font-size: 65px;

            margin-bottom: 20px;

        }

        .section-title span {

            color: #ff299f;

        }

        .description {

            max-width: 700px;

            color: #aaa;

            line-height: 1.8;

        }


        /* =========================
           HISTÓRIA
        ========================= */

        .story {

            background:
                linear-gradient(
                    180deg,
                    #08040d,
                    #12071a
                );

        }

        .cards {

            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 25px;

            margin-top: 50px;

        }

        .card {

            min-height: 350px;

            padding: 35px;

            display: flex;

            flex-direction: column;

            justify-content: flex-end;

            position: relative;

            overflow: hidden;

            border-radius: 10px;

            background:
                linear-gradient(
                    180deg,
                    transparent,
                    rgba(0,0,0,0.9)
                );

            transition: 0.4s;

        }

        .card:hover {

            transform: translateY(-10px);

        }

        .jason {

            background:
                linear-gradient(
                    180deg,
                    transparent,
                    #000
                ),
                url("https://images.unsplash.com/photo-1500648767791-00dcc994a43e")
                center/cover;

        }

        .lucia {

            background:
                linear-gradient(
                    180deg,
                    transparent,
                    #000
                ),
                url("https://images.unsplash.com/photo-1534528741775-53994a69daeb")
                center/cover;

        }

        .card h3 {

            font-size: 45px;

            margin-bottom: 10px;

        }

        .card p {

            color: #ccc;

            line-height: 1.6;

        }


        /* =========================
           VICE CITY
        ========================= */

        .vice {

            min-height: 600px;

            background:
                linear-gradient(
                    rgba(10,0,20,0.65),
                    rgba(10,0,20,0.9)
                ),
                url("https://images.unsplash.com/photo-1533104816931-20fa691ff6ca")
                center/cover;

        }

        .locations {

            display: grid;

            grid-template-columns:
                repeat(4,1fr);

            gap: 15px;

            margin-top: 40px;

        }

        .location {

            padding: 25px;

            background:
                rgba(255,255,255,0.08);

            border-left:
                4px solid #ff299f;

            transition: 0.3s;

        }

        .location:hover {

            background:
                rgba(255,41,159,0.2);

            transform: translateY(-5px);

        }

        .location h3 {

            margin-bottom: 10px;

        }

        .location p {

            color: #bbb;

            font-size: 14px;

        }


        /* =========================
           UNIVERSO
        ========================= */

        .features {

            background: #0d0614;

        }

        .feature-grid {

            display: grid;

            grid-template-columns:
                repeat(3,1fr);

            gap: 20px;

            margin-top: 50px;

        }

        .feature {

            padding: 30px;

            border:
                1px solid #29202d;

            background:
                rgba(255,255,255,0.04);

            transition: 0.3s;

        }

        .feature:hover {

            border-color: #ff299f;

            transform: translateY(-5px);

        }

        .feature .icon {

            font-size: 35px;

            margin-bottom: 20px;

        }

        .feature h3 {

            margin-bottom: 12px;

        }

        .feature p {

            color: #aaa;

            line-height: 1.6;

        }


        /* =========================
           CONTAGEM
        ========================= */

        .countdown-section {

            text-align: center;

            background:

                radial-gradient(
                    circle,
                    #44102f,
                    #08040d 65%
                );

        }

        .countdown {

            display: flex;

            justify-content: center;

            gap: 20px;

            margin-top: 40px;

            flex-wrap: wrap;

        }

        .time {

            width: 130px;

            padding: 25px;

            background:
                rgba(255,255,255,0.08);

            border:
                1px solid #333;

        }

        .time strong {

            display: block;

            font-size: 45px;

            color: #ff299f;

        }

        .time span {

            color: #aaa;

            font-size: 12px;

            text-transform: uppercase;

        }


        /* =========================
           MODAL
        ========================= */

        #modal {

            display: none;

            position: fixed;

            inset: 0;

            background:
                rgba(0,0,0,0.85);

            z-index: 2000;

            justify-content: center;

            align-items: center;

            padding: 20px;

        }

        .modal-box {

            max-width: 700px;

            width: 100%;

            padding: 40px;

            background: #130819;

            border:
                1px solid #ff299f;

            text-align: center;

        }

        .modal-box h2 {

            color: #ff299f;

            font-size: 45px;

            margin-bottom: 20px;

        }

        .modal-box p {

            color: #ccc;

            line-height: 1.8;

            margin-bottom: 25px;

        }


        /* =========================
           FOOTER
        ========================= */

        footer {

            text-align: center;

            padding: 50px 20px;

            background: #030205;

            color: #666;

        }

        footer strong {

            color: #ff299f;

        }


        /* =========================
           RESPONSIVO
        ========================= */

        @media(max-width:800px) {

            nav {
                display: none;
            }

            .cards {

                grid-template-columns: 1fr;

            }

            .locations {

                grid-template-columns:
                    1fr 1fr;

            }

            .feature-grid {

                grid-template-columns:
                    1fr;

            }

            .hero h2 {

                font-size: 32px;

            }

        }

        @media(max-width:500px) {

            .locations {

                grid-template-columns:
                    1fr;

            }

            .section-title {

                font-size: 48px;

            }

            h1 {

                font-size: 90px;

            }

        }

    </style>

</head>


<body>


    <!-- =========================
         MENU
    ========================= -->

    <header>

        <div class="logo">
            GTA<span>VI</span>
        </div>

        <nav>

            <a href="#inicio">
                Início
            </a>

            <a href="#historia">
                História
            </a>

            <a href="#vice">
                Vice City
            </a>

            <a href="#universo">
                Universo
            </a>

            <a href="#lancamento">
                Lançamento
            </a>

        </nav>

    </header>


    <!-- =========================
         HERO
    ========================= -->

    <section class="hero" id="inicio">

        <div class="hero-content">

            <div class="small-title">
                GRAND THEFT AUTO VI
            </div>

            <h1>
                GTA<br>
                VI
            </h1>

            <h2>
                BEM-VINDO À
                <span>VICE CITY.</span>
            </h2>

            <p>

                Um novo capítulo está chegando.
                Explore Leonida, conheça Jason e Lucia
                e prepare-se para uma nova história de
                crime, ambição e sobrevivência.

            </p>

            <a
                href="#historia"
                class="btn btn-primary"
            >
                Explorar
            </a>

            <button
                class="btn btn-secondary"
                onclick="abrirModal()"
            >
                Saiba mais
            </button>

        </div>

    </section>


    <!-- =========================
         HISTÓRIA
    ========================= -->

    <section
        class="story"
        id="historia"
    >

        <h2 class="section-title">

            UMA HISTÓRIA
            <span>DE CRIME.</span>

        </h2>

        <p class="description">

            Jason Duval e Lucia Caminos sabem que as
            probabilidades estão contra eles. Depois que
            um trabalho dá errado, os dois acabam envolvidos
            em uma conspiração que atravessa todo o estado
            de Leonida.

        </p>


        <div class="cards">


            <div class="card jason">

                <h3>
                    JASON
                </h3>

                <p>

                    Criado entre criminosos e golpistas,
                    Jason conhece bem o mundo do crime.
                    Agora ele busca uma vida melhor.

                </p>

            </div>


            <div class="card lucia">

                <h3>
                    LUCIA
                </h3>

                <p>

                    Depois de sair da prisão, Lucia está
                    determinada a mudar sua vida e não
                    pretende deixar ninguém ficar em seu caminho.

                </p>

            </div>


        </div>

    </section>


    <!-- =========================
         VICE CITY
    ========================= -->

    <section
        class="vice"
        id="vice"
    >

        <h2 class="section-title">

            O PARAÍSO
            <span>É PERIGOSO.</span>

        </h2>

        <p class="description">

            Vice City está de volta. Mas desta vez,
            a cidade é apenas uma parte de um mundo
            muito maior.

        </p>


        <div class="locations">


            <div class="location">

                <h3>
                    🌴 Vice City
                </h3>

                <p>
                    Praias, neon, festas e crime.
                </p>

            </div>


            <div class="location">

                <h3>
                    🐊 Leonida Keys
                </h3>

                <p>
                    Ilhas tropicais e águas abertas.
                </p>

            </div>


            <div class="location">

                <h3>
                    🌿 Pântanos
                </h3>

                <p>
                    Natureza selvagem e perigos.
                </p>

            </div>


            <div class="location">

                <h3>
                    🚘 Estradas
                </h3>

                <p>
                    Grandes estradas conectando Leonida.
                </p>

            </div>


        </div>

    </section>


    <!-- =========================
         UNIVERSO
    ========================= -->

    <section
        class="features"
        id="universo"
    >

        <h2 class="section-title">

            UM MUNDO
            <span>VIVO.</span>

        </h2>


        <div class="feature-grid">


            <div class="feature">

                <div class="icon">
                    🚗
                </div>

                <h3>
                    Veículos
                </h3>

                <p>
                    Explore as ruas de Leonida usando
                    carros, motos, barcos e muito mais.
                </p>

            </div>


            <div class="feature">

                <div class="icon">
                    🌃
                </div>

                <h3>
                    Vida noturna
                </h3>

                <p>
                    Clubes, festas, bares e noites
                    iluminadas pelo neon de Vice City.
                </p>

            </div>


            <div class="feature">

                <div class="icon">
                    💰
                </div>

                <h3>
                    Crime
                </h3>

                <p>
                    Golpes, negócios ilegais e
                    personagens envolvidos no submundo.
                </p>

            </div>


            <div class="feature">

                <div class="icon">
                    📱
                </div>

                <h3>
                    Redes sociais
                </h3>

                <p>
                    O mundo moderno também faz parte
                    da experiência de Leonida.
                </p>

            </div>


            <div class="feature">

                <div class="icon">
                    🌊
                </div>

                <h3>
                    Oceano
                </h3>

                <p>
                    As regiões costeiras fazem parte
                    da exploração do novo mundo.
                </p>

            </div>


            <div class="feature">

                <div class="icon">
                    🎵
                </div>

                <h3>
                    Música
                </h3>

                <p>
                    A atmosfera de Vice City é construída
                    também através de sua cultura musical.
                </p>

            </div>


        </div>

    </section>


    <!-- =========================
         CONTAGEM
    ========================= -->

    <section
        class="countdown-section"
        id="lancamento"
    >

        <div class="small-title">
            CONTAGEM REGRESSIVA
        </div>

        <h2 class="section-title">

            O DIA ESTÁ
            <span>CHEGANDO.</span>

        </h2>

        <p class="description"
           style="margin:auto;">

            Lançamento previsto para
            19 de novembro de 2026.

        </p>


        <div class="countdown">


            <div class="time">

                <strong id="dias">
                    000
                </strong>

                <span>
                    Dias
                </span>

            </div>


            <div class="time">

                <strong id="horas">
                    00
                </strong>

                <span>
                    Horas
                </span>

            </div>


            <div class="time">

                <strong id="minutos">
                    00
                </strong>

                <span>
                    Minutos
                </span>

            </div>


            <div class="time">

                <strong id="segundos">
                    00
                </strong>

                <span>
                    Segundos
                </span>

            </div>


        </div>

    </section>


    <!-- =========================
         RODAPÉ
    ========================= -->

    <footer>

        <p>

            <strong>GTA VI</strong>
            Fan Website

        </p>

        <p style="margin-top:10px;">

            Este é um projeto de fã não oficial.

        </p>

    </footer>


    <!-- =========================
         MODAL
    ========================= -->

    <div id="modal">

        <div class="modal-box">

            <h2>
                GTA VI
            </h2>

            <p>

                Prepare-se para voltar a Vice City.
                A nova aventura de Jason e Lucia
                promete levar o universo de Grand
                Theft Auto para uma nova geração.

            </p>

            <button
                class="btn btn-primary"
                onclick="fecharModal()"
            >
                Fechar
            </button>

        </div>

    </div>


    <!-- =========================
         JAVASCRIPT
    ========================= -->

    <script>

        /* =========================
           MODAL
        ========================= */

        function abrirModal() {

            document.getElementById("modal").style.display =
                "flex";

        }


        function fecharModal() {

            document.getElementById("modal").style.display =
                "none";

        }


        /* =========================
           CONTADOR
        ========================= */

        const dataLancamento =
            new Date("November 19, 2026 00:00:00").getTime();


        function atualizarContador() {

            const agora =
                new Date().getTime();

            const distancia =
                dataLancamento - agora;


            if (distancia <= 0) {

                document.getElementById("dias").innerHTML = "0";

                document.getElementById("horas").innerHTML = "00";

                document.getElementById("minutos").innerHTML = "00";

                document.getElementById("segundos").innerHTML = "00";

                return;

            }


            const dias =
                Math.floor(
                    distancia /
                    (1000 * 60 * 60 * 24)
                );


            const horas =
                Math.floor(
                    (distancia %
                    (1000 * 60 * 60 * 24))
                    /
                    (1000 * 60 * 60)
                );


            const minutos =
                Math.floor(
                    (distancia %
                    (1000 * 60 * 60))
                    /
                    (1000 * 60)
                );


            const segundos =
                Math.floor(
                    (distancia %
                    (1000 * 60))
                    /
                    1000
                );


            document.getElementById("dias").innerHTML =
                dias;

            document.getElementById("horas").innerHTML =
                String(horas).padStart(2, "0");

            document.getElementById("minutos").innerHTML =
                String(minutos).padStart(2, "0");

            document.getElementById("segundos").innerHTML =
                String(segundos).padStart(2, "0");

        }


        atualizarContador();

        setInterval(
            atualizarContador,
            1000
        );


        /* =========================
           FECHAR MODAL CLICANDO FORA
        ========================= */

        document.getElementById("modal")
            .addEventListener(
                "click",
                function(event) {

                    if (
                        event.target === this
                    ) {

                        fecharModal();

                    }

                }
            );

    </script>

</body>

</html>
