<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Brasileirão 2026 | Tabela e Clubes</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:
        radial-gradient(circle at top,#063b27 0,#031d15 38%,#020b08 100%);
    color:#fff;
    min-height:100vh;
}

.container{
    width:94%;
    max-width:1200px;
    margin:auto;
}

/* =========================
   CABEÇALHO
========================= */

header{
    text-align:center;
    padding:55px 20px 35px;
}

.logo-brasileirao{
    width:90px;
    height:90px;
    margin:auto;
    margin-bottom:18px;
    border-radius:25px;
    background:linear-gradient(145deg,#00a859,#006b3c);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:48px;
    box-shadow:0 15px 40px rgba(0,0,0,.35);
}

header h1{
    font-size:clamp(30px,5vw,55px);
    margin-bottom:10px;
}

header h1 span{
    color:#25d878;
}

header p{
    color:#b8d7ca;
    font-size:16px;
}

/* =========================
   TABELA
========================= */

.table-box{
    background:rgba(255,255,255,.97);
    color:#222;
    border-radius:22px;
    overflow:hidden;
    box-shadow:0 20px 70px rgba(0,0,0,.35);
    margin-bottom:70px;
}

.table-title{
    background:linear-gradient(135deg,#006b3c,#009c55);
    color:#fff;
    padding:25px;
}

.table-title h2{
    font-size:25px;
}

.table-title p{
    margin-top:6px;
    opacity:.85;
    font-size:14px;
}

.table-scroll{
    overflow-x:auto;
}

table{
    width:100%;
    min-width:850px;
    border-collapse:collapse;
}

thead{
    background:#151515;
    color:white;
}

th{
    padding:15px 9px;
    font-size:12px;
}

td{
    padding:11px 8px;
    text-align:center;
    border-bottom:1px solid #eee;
    font-size:13px;
}

td:nth-child(2){
    text-align:left;
}

tbody tr{
    transition:.2s;
}

tbody tr:hover{
    background:#f0fff7;
    transform:scale(1.002);
}

.pos{
    font-weight:bold;
    width:45px;
}

.team-cell{
    display:flex;
    align-items:center;
    gap:10px;
    font-weight:bold;
}

.escudo{
    width:36px;
    height:36px;
    object-fit:contain;
    background:#fff;
    border-radius:8px;
    padding:3px;
}

.points{
    font-weight:bold;
    color:#007c45;
}

.libertadores{
    border-left:5px solid #006b3c;
}

.pre{
    border-left:5px solid #00a859;
}

.sula{
    border-left:5px solid #2196f3;
}

.z4{
    border-left:5px solid #d32f2f;
    background:#fff5f5;
}

.legenda{
    padding:20px 25px;
    display:flex;
    flex-wrap:wrap;
    gap:18px;
    color:#555;
    font-size:13px;
}

.legend-item{
    display:flex;
    align-items:center;
    gap:7px;
}

.cor{
    width:14px;
    height:14px;
    border-radius:3px;
}

.c-verde{background:#006b3c}
.c-verde2{background:#00a859}
.c-azul{background:#2196f3}
.c-vermelho{background:#d32f2f}

/* =========================
   SEÇÃO DOS CLUBES
========================= */

.clubes-header{
    text-align:center;
    margin-bottom:35px;
}

.clubes-header h2{
    font-size:36px;
    margin-bottom:10px;
}

.clubes-header h2 span{
    color:#25d878;
}

.clubes-header p{
    color:#a9c9bc;
}

.clubes-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:25px;
    padding-bottom:80px;
}

.clube-card{
    background:rgba(255,255,255,.08);
    border:1px solid rgba(255,255,255,.1);
    border-radius:22px;
    overflow:hidden;
    backdrop-filter:blur(10px);
    transition:.35s;
}

.clube-card:hover{
    transform:translateY(-8px);
    box-shadow:0 20px 45px rgba(0,0,0,.4);
    border-color:#1bd777;
}

.clube-foto{
    height:190px;
    overflow:hidden;
    position:relative;
}

.clube-foto img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.5s;
}

.clube-card:hover .clube-foto img{
    transform:scale(1.08);
}

.clube-foto::after{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(transparent 45%,rgba(0,0,0,.75));
}

.clube-info{
    padding:20px;
    position:relative;
}

.clube-topo{
    display:flex;
    align-items:center;
    gap:12px;
    margin-top:-48px;
    position:relative;
    z-index:2;
    margin-bottom:15px;
}

.clube-topo img{
    width:65px;
    height:65px;
    object-fit:contain;
    background:white;
    border-radius:15px;
    padding:6px;
    box-shadow:0 7px 20px rgba(0,0,0,.4);
}

.clube-topo h3{
    font-size:21px;
}

.estado{
    color:#83bda5;
    font-size:12px;
    margin-top:3px;
}

.curiosidade{
    color:#d9eee5;
    line-height:1.6;
    font-size:14px;
}

.tag{
    display:inline-block;
    margin-top:15px;
    background:#006b3c;
    color:#fff;
    padding:6px 10px;
    border-radius:20px;
    font-size:11px;
}

/* =========================
   RODAPÉ
========================= */

footer{
    text-align:center;
    border-top:1px solid rgba(255,255,255,.1);
    padding:30px 15px;
    color:#719989;
    font-size:12px;
}

/* =========================
   MOBILE
========================= */

@media(max-width:600px){

    header{
        padding-top:35px;
    }

    .table-box{
        border-radius:15px;
    }

    .clubes-grid{
        grid-template-columns:1fr;
    }

    .clubes-header h2{
        font-size:29px;
    }
}
</style>
</head>

